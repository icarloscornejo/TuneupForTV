<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this only sets the window background shown before the first frame. -->
    <style name="Theme.TuneupForTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="window_background">#101418</color>
    <color name="ic_background">#101418</color>
</resources>
